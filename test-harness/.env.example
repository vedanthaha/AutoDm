# ==============================================================================
# AutoDm Test Harness Environment Configuration
# Standard: Instagram Login for Business (graph.instagram.com v26.0)
# ==============================================================================

# Meta Graph API Configuration
META_GRAPH_API_VERSION=v26.0
META_API_HOST=graph.instagram.com

# Meta App Credentials (from developers.facebook.com -> App Dashboard -> App Settings -> Basic)
META_APP_ID=
META_APP_SECRET=

# Webhook Handshake Verification Token (Arbitrary secret string you define)
META_VERIFY_TOKEN=autodm_dev_verify_token_2026

# Instagram Professional Account Credentials (for direct CLI testing)
# 1. INSTAGRAM_ACCOUNT_ID: The numeric Instagram Business/Creator Account ID
# 2. INSTAGRAM_USER_ACCESS_TOKEN: 60-day Instagram User Access Token with scopes:
#    - instagram_business_basic
#    - instagram_business_manage_messages
#    - instagram_business_manage_comments
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_USER_ACCESS_TOKEN=

# Automation Behavior
TRIGGER_KEYWORDS=link,guide,dm,send,auto
REPLY_MESSAGE=Hey {{username}}! Here is the link you requested: https://example.com/demo
PORT=3000
