# ==============================================================================
# AutoDm — Multi-Tenant Instagram Automation Platform (.env.example)
# Flow: Instagram Login for Business (graph.instagram.com v26.0)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Meta Developer App Credentials (https://developers.facebook.com)
# ------------------------------------------------------------------------------
# Meta App ID (Dashboard -> App Settings -> Basic -> App ID)
META_APP_ID=your_meta_app_id_here

# Meta App Secret (Dashboard -> App Settings -> Basic -> App Secret -> Show)
META_APP_SECRET=your_meta_app_secret_here

# Default Meta Graph API Version (Latest active version: v26.0)
META_GRAPH_API_VERSION=v26.0

# API Host for Instagram Login for Business
META_API_HOST=graph.instagram.com

# Webhook Verification Token (Arbitrary secret string you configure in Meta Webhooks dashboard)
META_VERIFY_TOKEN=autodm_webhook_verify_token_replace_me

# Instagram Login OAuth Callback URL
# Local: http://localhost:3000/api/auth/instagram/callback
# Production: https://<your-vercel-domain>.vercel.app/api/auth/instagram/callback
META_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# ------------------------------------------------------------------------------
# 2. Security & Token Vault (AES-256-GCM)
# ------------------------------------------------------------------------------
# 32-byte secret key used to encrypt customer long-lived Instagram tokens at rest
# Generate in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# ------------------------------------------------------------------------------
# 3. Supabase Multi-Tenant Database & Auth (https://supabase.com)
# ------------------------------------------------------------------------------
# Supabase Project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Project Settings -> API -> Project API keys -> anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Secret Key (Project Settings -> API -> Project API keys -> service_role)
# Keep strictly secret — used exclusively by server-side webhook dispatcher
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 4. Application URL
# ------------------------------------------------------------------------------
# Your production domain (used for OAuth callbacks, webhook URLs, and legal page links)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Local Development Server
# ------------------------------------------------------------------------------
PORT=3000

# ==============================================================================
# META DASHBOARD CONFIGURATION REFERENCE
# ==============================================================================
# The following URLs must be entered into the Meta Developer Dashboard.
# They are NOT environment variables — this section is for your reference only.
#
# Instagram Login > Valid OAuth Redirect URIs:
#   ${NEXT_PUBLIC_APP_URL}/api/auth/instagram/callback
#
# Webhooks > Instagram > Callback URL:
#   ${NEXT_PUBLIC_APP_URL}/api/webhooks/instagram
#
# Webhooks > Verify Token:
#   (Use the value of META_VERIFY_TOKEN above)
#
# App Settings > Basic > Deauthorize Callback URL:
#   ${NEXT_PUBLIC_APP_URL}/api/webhooks/instagram/deauthorize
#
# App Settings > Basic > Data Deletion Request URL:
#   ${NEXT_PUBLIC_APP_URL}/api/webhooks/instagram/data-deletion
#
# App Settings > Basic > Privacy Policy URL:
#   ${NEXT_PUBLIC_APP_URL}/privacy
#
# App Settings > Basic > Terms of Service URL:
#   ${NEXT_PUBLIC_APP_URL}/terms
# ==============================================================================
